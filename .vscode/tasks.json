{
  "version": "2.0.0",
  "tasks": [
    // ─── SASS (Pika build) ────────────────────────────────────────────────────
    // Mirrors the PhpStorm "SCSS (Pika build)" file watcher. Replaces the old
    // Less → PostCSS → CleanCSS chain: dart-sass writes main.css and main.min.css
    // in one pass, so there is nothing to autoprefix or minify afterwards.
    // Scope: any *.scss under vufind/web/interface/themes.
    // Per-file command (run at the repository root):
    //   node build/css/build.mjs --file=<path>
    //
    // Rebuilds only the theme that owns the saved file. A change to a shared
    // responsive partial still needs a full `npm run build` before committing.
    //
    // Prerequisite: npm install
    {
      "label": "Watch SASS (theme scss → main.css + main.min.css)",
      "type": "shell",
      "command": "node .vscode/watch-sass.js",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "label": "SASS Watcher"
      },
      "problemMatcher": {
        "owner": "sass",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+) in (.+) on line (\\d+), column (\\d+):$",
          "message": 1,
          "file": 2,
          "line": 3,
          "column": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[sass\\] Watching",
          "endsPattern": "\\[sass\\]  (→|✗)"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }

    ,
    // ─── UglifyJS Minifier ────────────────────────────────────────────────────
    // Scope: any *.js file directly in vufind/web/interface/themes/responsive/js/pika,
    //        excluding files already ending in .min.js.
    // Per-file command (run in file's own directory):
    //   uglifyjs <file>.js -o <file>.min.js
    //
    // Prerequisites: npm install --save-dev uglify-js chokidar
    {
      "label": "Watch UglifyJS Minifier (pika js → min.js)",
      "type": "shell",
      "command": "node .vscode/watch-uglifyjs.js",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "label": "UglifyJS Watcher"
      },
      "problemMatcher": {
        "owner": "uglifyjs",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(WARN|ERROR): (.+)$",
          "severity": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[uglifyjs\\] Watching",
          "endsPattern": "\\[uglifyjs\\]  (→|✗)"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
