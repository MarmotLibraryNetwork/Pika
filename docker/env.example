# Copy to .env in the repository root (next to docker-compose.yml). .env is git-ignored.

# Site directory name under sites/ - also the hostname you browse to.
PIKA_SITE=marmot.localhost

# Checkout of the PikaSettings repository on the Docker host.
PIKA_SETTINGS_DIR=/usr/share/php/pika/settings

# Apache vhost file inside ${PIKA_SETTINGS_DIR}/${PIKA_SITE}/
PIKA_VHOST_CONF=httpd-marmot.locaclhost-2.4-linux.conf

# Must match the pika user's password in sites/<site>/conf/config.pwd.ini [Database]
PIKA_DB_PASSWORD=
PIKA_DB_ROOT_PASSWORD=

# Host ports
PIKA_HTTP_PORT=8088
#PIKA_MAIL_UI_PORT=8025

# Uncomment to also publish Solr and MariaDB on 127.0.0.1 (see docker/compose.ports.yml)
#COMPOSE_FILE=docker-compose.yml:docker/compose.ports.yml
#SOLR_SEARCHER_HOST_PORT=8080
#SOLR_MASTER_HOST_PORT=8180
#PIKA_DB_HOST_PORT=3306

# Versions
#PHP_VERSION=8.5
#MARIADB_VERSION=11.8
#SOLR_VERSION=8.8.2

# Per Solr node
#SOLR_HEAP=1g

# off, or e.g. debug,develop
#XDEBUG_MODE=off
#TZ=America/Denver
